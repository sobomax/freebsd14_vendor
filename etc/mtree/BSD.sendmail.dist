/set type=dir uname=root gname=wheel mode=0755
.               nochange
    var             nochange
        spool           nochange tags=package=runtime
            clientmqueue    uname=smmsp gname=smmsp mode=0770 tags=package=sendmail
            ..
            mqueue          gname=daemon tags=package=sendmail
            ..
        ..
    ..
..
