# $FreeBSD: 50829d629a4d8f8999b785303218ad16a5f42417 $
# Some builtins should not be overridable via PATH.

set -e
T=$(mktemp -d ${TMPDIR:-/tmp}/sh-test.XXXXXX)
trap 'rm -rf ${T}' 0
echo '#!/bin/sh
echo bad' >"$T/cd"
chmod 755 "$T/cd"
cd /bin
oPATH=$PATH
PATH=$T:$PATH:%builtin
cd /
PATH=$oPATH
[ "$(pwd)" = / ]
