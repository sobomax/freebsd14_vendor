# $FreeBSD: 8f0b41a0a3f78a7a1918fe90a3b49e758f1e6d41 $

[ $'hello\0' = hello ]
[ $'hello\0world' = hello ]
[ $'hello\0'$'world' = helloworld ]
[ $'hello\000' = hello ]
[ $'hello\000world' = hello ]
[ $'hello\000'$'world' = helloworld ]
[ $'hello\x00' = hello ]
[ $'hello\x00world' = hello ]
[ $'hello\x00'$'world' = helloworld ]
