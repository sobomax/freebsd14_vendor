ident		MALTA64

include		"std.MALTA"
 
machine		mips mips64
 
makeoptions	ARCH_FLAGS="-march=mips64 -mabi=64"
 
makeoptions 	KERNLOADADDR=0xffffffff80100000

options 	COMPAT_FREEBSD32	# Compatible with o32 binaries
