#!/bin/sh

set -e

FBSD_VER="13.2"

_FBSD_VER="`echo ${FBSD_VER} | sed 's|[.]|_|g'`"
FBSD_BR="releng/${FBSD_VER}"
OUR_BR="releng_${FBSD_VER}"
TAG_BR="RELENG_${_FBSD_VER}"

if [ -e .freebsd_import ]
then
  rm -rf .freebsd_import
fi

git fetch freebsd
CHASH="`git rev-parse --short freebsd/${FBSD_BR}`"
git checkout "${CHASH}"

repofiles="`echo [^.]*`"
rm -rf ${repofiles}
echo '* ident=FreeBSD' > .gitattributes
git checkout -- ${repofiles}

mkdir .freebsd_import
mv [^.]* .freebsd_import
rm .gitattributes
find .freebsd_import -name .gitignore -delete
git reset --hard
git checkout "${OUR_BR}"
git pull
git rm -r [^.]*
mv .freebsd_import/* ./
rmdir .freebsd_import
git add -A [^.]*
git commit -m "Update from ${FBSD_BR}, git revision ${CHASH}."
git tag -f "FreeBSD.${TAG_BR}.${CHASH}"
echo git push origin "${OUR_BR}"
echo git push --force origin "FreeBSD.${TAG_BR}.${CHASH}"
